# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Temporary files
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.log
log.txt
npm-debug.log
yarn-error.log

# OS / system files
.DS_Store
Thumbs.db
$RECYCLE.BIN/
UserInterfaceState.xcuserstate

# Build / generated output
/.sourcemaps
/.versions
/.ionic
/.angular
/.angular/cache
/www
/dist
/tmp
/out-tsc
/bazel-out
/coverage
/connect.lock
/libpeerconnection.log
testem.log
/typings
.sass-cache/

# Node
/node_modules

# Legacy Ionic / Cordova folders
/platforms
/plugins

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace
.history/*

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Android / Capacitor generated files
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
